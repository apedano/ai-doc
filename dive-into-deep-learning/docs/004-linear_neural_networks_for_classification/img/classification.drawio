        <mxCell id="Hly_gRKwgqpdyyuiXI0w-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" value="&lt;b&gt;Cross entropy loss&lt;/b&gt;&lt;div&gt;the everage over all samples of the prob of the correct class in y&amp;nbsp;&lt;br&gt;&lt;div&gt;&lt;div style=&quot;background-color: rgb(30, 31, 34); color: rgb(188, 190, 196);&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9,8pt;&quot;&gt;&lt;span style=&quot;color: rgb(95, 130, 107); font-style: italic;&quot;&gt;L (scalar)= -(1/N) * Σ&lt;/span&gt;&lt;span style=&quot;color: rgb(95, 130, 107); font-style: italic; font-family: &amp;quot;Courier New&amp;quot;, monospace;&quot;&gt;ᵢ&lt;/span&gt;&lt;span style=&quot;color: rgb(95, 130, 107); font-style: italic;&quot;&gt; log(p[i, y&lt;/span&gt;&lt;span style=&quot;color: rgb(95, 130, 107); font-style: italic; font-family: &amp;quot;Courier New&amp;quot;, monospace;&quot;&gt;ᵢ&lt;/span&gt;&lt;span style=&quot;color: rgb(95, 130, 107); font-style: italic;&quot;&gt;])&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="300" x="420" y="480" as="geometry" />
        </mxCell>
        <mxCell id="Hly_gRKwgqpdyyuiXI0w-13" edge="1" parent="1" source="Hly_gRKwgqpdyyuiXI0w-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Hly_gRKwgqpdyyuiXI0w-12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Hly_gRKwgqpdyyuiXI0w-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" value="&lt;b&gt;Backrard pass&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(73, 74, 79); font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; white-space: pre; background-color: rgb(209, 210, 212);&quot;&gt;cross_entropy_grad: &lt;/span&gt;&lt;br style=&quot;color: rgb(73, 74, 79); font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; white-space: pre; background-color: rgb(209, 210, 212);&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; white-space: pre; color: rgb(106, 171, 115); background-color: rgb(41, 60, 64);&quot;&gt;dL_dz = (probs - one_hot(y)) / N&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;background-color: rgb(30, 31, 34); color: rgb(188, 190, 196);&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9,8pt;&quot;&gt;&lt;span style=&quot;color: rgb(106, 171, 115); background-color: rgb(41, 60, 64);&quot;&gt;dW = X.T @ dL_dz # (64, 4)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(106, 171, 115); background-color: rgb(41, 60, 64);&quot;&gt;db = dL_dz .sum(axis=0)  # (4,)&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;sada&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="179" width="290" x="425" y="691" as="geometry" />
        </mxCell>
        <mxCell id="Hly_gRKwgqpdyyuiXI0w-14" edge="1" parent="1" source="Hly_gRKwgqpdyyuiXI0w-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="Hly_gRKwgqpdyyuiXI0w-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Hly_gRKwgqpdyyuiXI0w-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" value="&lt;b&gt;Update&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;background-color: rgb(30, 31, 34); color: rgb(188, 190, 196);&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9,8pt;&quot;&gt;&lt;span style=&quot;color: rgb(106, 171, 115); background-color: rgb(41, 60, 64);&quot;&gt;W -= eta * dW&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(106, 171, 115); background-color: rgb(41, 60, 64);&quot;&gt;b -= eta * db&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="290" x="425" y="910" as="geometry" />
        </mxCell>
        <mxCell id="Hly_gRKwgqpdyyuiXI0w-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Train done:&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;sample evaluation&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;background-color: rgb(30, 31, 34); color: rgb(188, 190, 196);&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9,8pt;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;color: rgb(106, 171, 115); background-color: rgb(41, 60, 64);&quot;&gt;true_class = 0  # &quot;Circle&quot;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(106, 171, 115); background-color: rgb(41, 60, 64);&quot;&gt;x = make_image(true_class, noise=0.0)  # clean image, shape (64,)&lt;br&gt;&lt;br&gt;&lt;div style=&quot;background-color: rgb(30, 31, 34); color: rgb(188, 190, 196);&quot;&gt;&lt;pre style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace;&quot;&gt;&lt;span style=&quot;color: rgb(106, 171, 115); background-color: rgb(41, 60, 64);&quot;&gt;logits = x @ W + b&lt;br&gt;&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;pre style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace;&quot;&gt;&lt;span style=&quot;color: rgb(106, 171, 115); background-color: rgb(41, 60, 64);&quot;&gt;probs = softmax(logits[None])[0] #only one sample so [0]&lt;br&gt;&lt;div style=&quot;background-color: rgb(30, 31, 34); color: rgb(188, 190, 196);&quot;&gt;&lt;pre style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace;&quot;&gt;&lt;div style=&quot;background-color: rgb(30, 31, 34); color: rgb(188, 190, 196);&quot;&gt;&lt;pre style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace;&quot;&gt;&lt;span style=&quot;color: rgb(106, 171, 115); background-color: rgb(41, 60, 64);&quot;&gt;prediction = probs.argmax()&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/span&gt;&lt;/font&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="530" x="190" y="1010" as="geometry" />
        </mxCell>
